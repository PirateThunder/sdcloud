    {
      "id": "confirm_nonlinear_recovery",
      "description": "A two-state recovery system starts with v=1 and w=0. Use dv/dt = v - v^3/3 - w + 0.8 and dw/dt = 0.1*(v + 0.6 - 0.75*w). Both states have units `state`, model time has unit `time`, and the horizon is 100 time units. Use named scale constants for dimensional consistency.",
      "components": [
        {
          "kind": "polynomial_ode",
          "stock": "v",
          "initial": 1.0,
          "units": {
            "state": 1
          },
          "time_unit": "time",
          "terms": [
            {
              "coefficient": 1.0,
              "expression": "v",
              "sign": 1,
              "name": "linear_v"
            },
            {
              "coefficient": "cubic_coefficient",
              "expression": "v^3",
              "sign": -1,
              "name": "cubic_v"
            },
            {
              "coefficient": 1.0,
              "expression": "w",
              "sign": -1,
              "name": "inhibition_by_w"
            },
            {
              "coefficient": "external_drive",
              "expression": "1",
              "sign": 1,
              "name": "external_drive"
            }
          ],
          "parameters": [
            {
              "id": "cubic_coefficient",
              "value": 1.0,
              "role": "scale",
              "units": null
            },
            {
              "id": "external_drive",
              "value": 0.8,
              "role": "scale",
              "units": null
            }
          ]
        },
        {
          "kind": "polynomial_ode",
          "stock": "w",
          "initial": 0.0,
          "units": {
            "state": 1
          },
          "time_unit": "time",
          "terms": [
            {
              "coefficient": "recovery_rate",
              "expression": "v + threshold_offset - self_inhibition_scale * w",
              "sign": 1,
              "name": "recovery_dynamics"
            }
          ],
          "parameters": [
            {
              "id": "recovery_rate",
              "value": 0.1,
              "role": "rate",
              "units": null
            },
            {
              "id": "threshold_offset",
              "value": 0.6,
              "role": "threshold",
              "units": null
            },
            {
              "id": "self_inhibition_scale",
              "value": 0.75,
              "role": "scale",
              "units": null
            }
          ]
        }
      ],
      "time": {
        "unit": "time",
        "initial_time": 0.0,
        "final_time": 100.0,
        "time_step": 0.01,
        "saveper": 0.02
      },
