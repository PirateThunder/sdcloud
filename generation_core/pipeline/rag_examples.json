      "id": "confirm_logistic_harvest",
      "description": "A biological reserve follows d(biomass)/dt = 0.3*biomass*(1 - biomass/200) - 0.1*biomass. Start with biomass=20 tonne and use an 80 year horizon. Keep tonne and year units consistent and represent 200 tonne as a named upper bound.",
      "components": [
        {
          "kind": "polynomial_ode",
          "stock": "biomass",
          "initial": 20.0,
          "units": {
            "tonne": 1
          },
          "time_unit": "year",
          "terms": [
            {
              "coefficient": "growth_rate",
              "expression": "biomass * (1 - biomass / upper_bound_biomass)",
              "sign": 1,
              "name": "logistic_growth"
            },
            {
              "coefficient": "mortality_rate",
              "expression": "biomass",
              "sign": -1,
              "name": "mortality_loss"
            }
          ],
          "parameters": [
            {
              "id": "growth_rate",
              "value": 0.3,
