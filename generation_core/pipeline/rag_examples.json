              "units": null
            },
            {
              "id": "mortality_rate",
              "value": 0.1,
              "role": "rate",
              "units": null
            },
            {
              "id": "upper_bound_biomass",
              "value": 200.0,
              "role": "threshold",
              "units": null
            }
          ]
        }
      ],
      "time": {
        "unit": "year",
        "initial_time": 0.0,
