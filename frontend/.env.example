# ──────────────────────────────────────────────────────────────
# sdCloud Frontend — Environment Configuration
#
# Скопируйте файл в .env.local (или .env) и замените значения:
#   cp frontend/.env.example frontend/.env.local
#
# ВАЖНО: frontend/.env* уже добавлен в .gitignore, не коммитьте секреты.
#
# NEXT_PUBLIC_ префикс обязателен — иначе переменная не попадёт
# в клиентский JavaScript-бандл Next.js.
# ──────────────────────────────────────────────────────────────

# Локальная разработка
# NEXT_PUBLIC_API_URL=http://localhost:54101

# Production
NEXT_PUBLIC_API_URL=https://api.sdcloud.piratethunder.space

# Project version shown in UI
NEXT_PUBLIC_APP_VERSION=1.0.2
