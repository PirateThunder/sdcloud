# ──────────────────────────────────────────────────────────────
# sdCloud Backend — Environment Configuration
#
# Скопируйте файл в .env и замените значения на реальные:
#   cp backend/.env.example backend/.env
#
# ВАЖНО: backend/.env уже добавлен в .gitignore, не коммитьте секреты.
# ──────────────────────────────────────────────────────────────

# Application
APP_NAME=sdCloud
APP_VERSION=1.0.2
DEBUG=false
ENVIRONMENT=development

# Server
# Внутренний порт контейнера backend (случайный high-range порт).
HOST=0.0.0.0
PORT=54101

# ── Database ─────────────────────────────────────────────────
# Локально (shared-инфраструктура) PostgreSQL проброшен на host-порт 50728.
# DATABASE_URL=postgresql+asyncpg://sdcloud:sdcloud@localhost:50728/sdcloud

# В production используется shared PostgreSQL в сети shared_network.
# Замените имя хоста, пользователя, пароль и базу на свои значения
# (см. пример shared-инфраструктуры в deploy/infra-example/).
DATABASE_URL=postgresql+asyncpg://sdcloud:CHANGE_PASSWORD@shared-postgres:5432/sdcloud

# ── Redis ────────────────────────────────────────────────────
# Локально (shared-инфраструктура) Redis проброшен на host-порт 54507.
# Используем БД Redis с индексом 1, чтобы не конфликтовать с другими проектами.
# REDIS_URL=redis://localhost:54507/1

# Production: shared Redis в сети shared_network.
# Имя хоста должно совпадать с именем контейнера shared-redis.
REDIS_URL=redis://shared-redis:6379/1

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
# Локальная разработка
# FRONTEND_URL=http://localhost:56555
# CORS_ORIGINS=http://localhost:56555,http://localhost:5173

# Production
FRONTEND_URL=https://sdcloud.piratethunder.space
CORS_ORIGINS=https://sdcloud.piratethunder.space

# ── OpenRouter API ───────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openrouter/google/gemma-4-31b-it:free
