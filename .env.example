GEN_DB_PASSWORD=gen-local-password
BACK_DB_PASSWORD=back-local-password
SERV_API_KEY=local-internal-core-key

BACK_ENV=local
BACK_HOST_PORT=61231
FRONTEND_HOST_PORT=56556
GEN_HOST_PORT=58312
BACK_JWT_SECRET=sdcloud-local-jwt-secret-change-me
BACK_OTP_SECRET=sdcloud-local-otp-secret-change-me
BACK_EMAIL_DEV_CODE=1
BACK_CORS_ORIGINS=http://localhost:3000,http://localhost:56556,http://127.0.0.1:56556
BACK_TRUST_PROXY_HEADERS=0

BACK_SMTP_HOST=
BACK_SMTP_PORT=465
BACK_SMTP_USER=
BACK_SMTP_PASSWORD=
BACK_SMTP_FROM=

LLM_PROVIDER=fixture
LLM_FIXTURE_PATH=/app/fixtures/llm_responses.json
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# OPENROUTER_PROVIDER_ORDER=CoreWeave
# OPENROUTER_ALLOW_PROVIDER_FALLBACK=0
LLM_STRUCTURED_OUTPUT=1
LLM_COMPONENT_STRUCTURED_OUTPUT=0
LLM_PATTERN_SHORTCUT=0
LLM_ALLOW_UNSTRUCTURED_FALLBACK=0
LLM_MAX_TOKENS=8192
LLM_MAX_REPAIRS=3
LLM_REQUEST_RETRIES=5
LLM_RETRY_DELAY=2
# LLM_SEED=
LLM_RAG_ENABLED=0
LLM_RAG_CORPUS_PATH=/app/pipeline/rag_examples.json
LLM_RAG_MAX_EXAMPLES=1
LLM_RAG_MIN_SCORE=0.08
LLM_RAG_MAX_CHARS=3500
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=QuantTrio/Qwen3-VL-30B-A3B-Instruct-AWQ
LOCAL_LLM_TIMEOUT=300
LOCAL_LLM_STRUCTURED_OUTPUT=1
LOCAL_LLM_ALLOW_UNSTRUCTURED_FALLBACK=0
LOCAL_LLM_MAX_TOKENS=8192
# LOCAL_LLM_SEED=
# Optional local 8B/30B routing; disabled unless explicitly enabled.
LLM_DYNAMIC_ROUTING=0
LLM_LARGE_MIN_FREE_MIB=20000
LLM_DYNAMIC_LOCAL_FALLBACK=1
LLM_DYNAMIC_CLOUD_FALLBACK=0
# LLM_DYNAMIC_CLOUD_MODEL=qwen/qwen3-30b-a3b-instruct-2507
LOCAL_LLM_LARGE_MODEL=QuantTrio/Qwen3-VL-30B-A3B-Instruct-AWQ
LOCAL_LLM_LARGE_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_LARGE_MAX_TOKENS=4096
LOCAL_LLM_SMALL_MODEL=Qwen/Qwen3-8B-GGUF:Q4_K_M
LOCAL_LLM_SMALL_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_SMALL_MAX_TOKENS=4096
# LOCAL_LLM_LARGE_API_KEY=
# LOCAL_LLM_SMALL_API_KEY=
LLM_VRAM_NVIDIA_SMI=nvidia-smi
LLM_VRAM_GPU_INDEX=0
# LLM_VRAM_SSH_TARGET=
LLM_VRAM_SSH_PORT=22
VLLM_MODEL=QuantTrio/Qwen3-VL-30B-A3B-Instruct-AWQ
VLLM_MAX_LEN=16384
VLLM_GPU_MEM=0.92
VLLM_HOST_PORT=8000
VLLM_HEALTH_START_PERIOD=1800s
# GGUF small endpoint uses llama.cpp, not vLLM.
LLAMA_CPP_IMAGE_TAG=server-cuda
# LLAMA_SMALL_MODEL=/root/.cache/huggingface/.../Qwen3-8B-Q4_K_M.gguf
LLAMA_SMALL_CTX_SIZE=8192
LLAMA_SMALL_N_GPU_LAYERS=99

# Optional production profile: docker-compose.yml + docker-compose.production.yml.
